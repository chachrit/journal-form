Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # บล็อกไฟล์/โฟลเดอร์ภายในไม่ให้เข้าจากเว็บ
    RewriteRule ^(lib|templates|storage|database|tests|vendor|docs|_old)(/|$) - [NC,F,L]
    RewriteRule ^(config\.php|composer\.(json|lock)|phpunit\.xml(\.dist)?)$ - [NC,F,L]
    RewriteRule \.(md|sql|lock|log|bak|ini|sh|json)$ - [NC,F,L]
    RewriteRule (^|/)\. - [NC,F,L]

    # ลิงก์ฟอร์มแบบสั้น /f/{slug} → form.php?slug={slug}
    RewriteRule ^f/([a-z0-9-]+)/?$ form.php?slug=$1 [L,QSA]
</IfModule>

# ถ้า mod_rewrite ปิดอยู่ ห้ามเปิดใช้งานระบบ — โฟลเดอร์ภายในจะเข้าจากเว็บได้
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
